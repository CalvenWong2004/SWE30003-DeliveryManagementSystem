---
title: "YOWD DMS final class diagram (1 of 2): delivery and payment domain"
---
classDiagram
direction TB
note "Green = new in A3 · Amber = changed from A2 · Grey = as designed in A2"
class DeliveryRequest {
  +requestId: str
  +trackingCode: str
  +clientId: str
  +createdById: str
  +serviceLevel: ServiceLevel
  +assignedStaffId: str
  +status: DeliveryStatus
  +attach(observer)
  +issueQuote(quote)
  +declineRequest(reason, at, by)
  +acceptQuote(method, at, by)
  +declineQuote(at, by)
  +expireIfLapsed(now) bool
  +createPayment(method, at) Payment
  +changePaymentMethod(method, at) Payment
  +invoice(billTo, at) Invoice
  +allocate(staffId, at, by, name)
  +releaseAllocation(at, by, reason)
  +recordPickup(staffId, name, at)
  +recordHandover(staffId, receivedBy, at)
  +cancel(at, by, reason)
  +currentHolder(parcelLabel) str
  +committedPeriod() Period
}
class Quote {
  +suggestedFee: float
  +fee: float
  +adjustmentReason: str
  +distanceKm: float
  +estimatedPickup: datetime
  +estimatedDelivery: datetime
  +issuedAt: datetime
  +issuedByUserId: str
  +validUntil: datetime
  +isValidAt(now) bool
}
class Address {
  <<data holder>>
  street, suburb, postcode, state
}
class Parcel {
  <<data holder>>
  label, description, size, weightKg
}
class Recipient {
  <<data holder>>
  name, phone
}
class StatusChange {
  <<data holder>>
  status, at, byUserId, note
}
class CustodyRecord {
  <<data holder>>
  parcelLabel, holder, at, event
}
class Payment {
  <<abstract>>
  +paymentId: str
  +amount: float
  +status: PaymentStatus
  +paidAt: datetime
  +reference: str
  +cardType: str
  +recordedBy: str
  +note: str
  +invoiceNumber() str
  +collectedByDriver()* bool
  +recordManual(at, by, note)
  +issueInvoice(requestId, billTo, lines, at) Invoice
  +cancel(at)
}
class OnlinePayment {
  +settle(gateway, at) str
}
class CashOnDelivery {
  +recordCollection(amount, staffId, at)
}
class PaymentGateway {
  <<interface>>
  +charge(paymentId, amount) ChargeResult
}
class SimulatedPaymentGateway {
  +declineNext: bool
  +charge(paymentId, amount) ChargeResult
}
class ChargeResult {
  <<data holder>>
  reference, cardType
}
class Invoice {
  <<data holder>>
  invoiceNumber, issuedAt, requestId, billTo
  lines, total, method, status
  reference, cardType, paidAt
}
class DeliveryObserver {
  <<interface>>
  +onStatusChange(request, change)
}
class NotificationService {
  +onStatusChange(request, change)
  +notifyNewRequest(request)
}
DeliveryRequest "1" *-- "0..1" Quote
DeliveryRequest "1" *-- "2" Address : pickup, drop-off
DeliveryRequest "1" *-- "1..10" Parcel
DeliveryRequest "1" *-- "1" Recipient
DeliveryRequest "1" *-- "1..*" StatusChange
DeliveryRequest "1" *-- "*" CustodyRecord
DeliveryRequest "1" *-- "0..1" Payment
DeliveryRequest "1" o-- "*" DeliveryObserver : notifies
DeliveryRequest ..> Invoice : builds lines for
Payment <|-- OnlinePayment
Payment <|-- CashOnDelivery
Payment ..> Invoice : issues
PaymentGateway <|.. SimulatedPaymentGateway
OnlinePayment ..> PaymentGateway : charges via
PaymentGateway ..> ChargeResult : returns
DeliveryObserver <|.. NotificationService
