---
config:
  layout: elk
title: "YOWD DMS final class diagram (2 of 2): application structure, users and staff"
---
classDiagram
direction TB
note "Green = new in A3 · Amber = changed from A2 · Grey = as designed in A2"
class ConsoleApp {
  +run()
}
class ConsoleIO {
  +ask(label, convert, hint, secret, default)
  +choose(label, options) str
  +confirm(question) bool
  +table(headers, rows)
}
class RoleScreens {
  <<ClientScreens / OfficeScreens / DriverScreens>>
  +menu: dict
  +handle(choice)
}
class AccountScreens {
  <<module>>
  +myDetails(io, dms)
  +editContact(io, user) ContactChange
}
class DeliveryManagementSystem {
  <<Singleton / Facade>>
  -session: User
  +start(dataDir, clock, gateway)$
  +login(email, password) User
  +updateMyDetails(name, phone, address)
  +changeMyPassword(current, new)
  +updateUserDetails(userId, name, phone, address)
  +deactivateClient(userId)
  +addStaff(role, name, email, phone, password)
  +deactivateStaff(userId, allowNoCover) list
  +requestDelivery(...) DeliveryRequest
  +issueQuote(id, pickup, fee, reason) Quote
  +respondToQuote(id, accept, method)
  +payOnline(id) str
  +invoice(id) Invoice
  +paymentRecords(status) list
  +recordPaymentManually(id, note)
  +allocate(id, staffId)
  +removeAvailability(availabilityId, allowNoCover) list
  +recordPickup(id)
  +recordHandover(id, receivedBy)
  +statistics(period, date, staffId) Statistics
}
class UserDirectory {
  +load() / save()
  +createUser(role, ...) User
  +authenticate(email, password) User
  +updateDetails(user, name, phone, address)
  +changePassword(user, current, new)
  +find(userId) User
}
class StaffRoster {
  +load() / save()
  +addAvailability(staffId, start, end)
  +conflictsIfRemoved(availabilityId) list
  +gapsIfRemoved(availabilityId, now) list
  +gapsIfStaffLeaves(staffId, now) list
  +isFree(staffId, start, end) bool
  +availableStaff(start, end) list
}
class DeliveryRegistry {
  +load() / save() / attachObservers()
  +verifyIntegrity()
  +createRequest(...) DeliveryRequest
  +suggestQuote(request, pickup) QuoteSuggestion
  +expireLapsedQuotes() list
  +search(text) list
  +findByTracking(code) DeliveryRequest
  +statistics(period, date, staffId) Statistics
}
class User {
  <<abstract>>
  +userId, name, email, phone
  +state: AccountState
  +failedLogins, lockedUntil
  +verifyPassword(password) bool
  +updateContact(name, phone)
  +can(operation) bool
  +permittedOperations()*
}
class Client {
  +defaultAddress: str
  +updateAddress(address)
}
class OfficeStaff
class BusinessOwner
class DeliveryStaff
class StaffAvailability {
  +start, end
  +covers(start, end) bool
  +overlaps(start, end) bool
}
class PricingStrategy {
  <<abstract>>
  +suggestFee(request, km)*
  +deliveryWindow(km)*
}
class StandardPricing
class ExpressPricing
class ServiceArea {
  +check(address) AreaCheck
  +distanceKm(origin, destination) float
}
class NotificationService
class PaymentGateway {
  <<interface>>
}
class JsonStore {
  <<with Data Mappers>>
  +load(collection) list
  +save(collection, records)
  +userToDict() / requestToDict() ...
}
class Clock {
  +now() datetime
}
class IntegrityError
class DeliveryRequest
ConsoleApp *-- ConsoleIO
ConsoleApp ..> RoleScreens : routes by role
RoleScreens ..> AccountScreens : my details
RoleScreens --> DeliveryManagementSystem : every use case
DeliveryManagementSystem *-- UserDirectory
DeliveryManagementSystem *-- StaffRoster
DeliveryManagementSystem *-- DeliveryRegistry
DeliveryManagementSystem *-- ServiceArea
DeliveryManagementSystem *-- NotificationService
DeliveryManagementSystem --> PaymentGateway
DeliveryManagementSystem --> Clock
UserDirectory "1" o-- "*" User
User <|-- Client
User <|-- OfficeStaff
OfficeStaff <|-- BusinessOwner
User <|-- DeliveryStaff
StaffRoster "1" o-- "*" StaffAvailability
StaffAvailability "*" --> "1" DeliveryStaff
StaffRoster --> UserDirectory
DeliveryRegistry "1" o-- "*" DeliveryRequest
DeliveryRegistry --> ServiceArea : validates addresses
DeliveryRegistry --> "2" PricingStrategy
DeliveryRegistry --> StaffRoster
DeliveryRegistry --> UserDirectory
DeliveryRegistry ..> IntegrityError : raises at startup
PricingStrategy <|-- StandardPricing
PricingStrategy <|-- ExpressPricing
DeliveryRequest "*" --> "1" Client : for
DeliveryRequest "*" --> "0..1" DeliveryStaff : allocated to
DeliveryManagementSystem *-- JsonStore : shared by the 3 registries
